# ==============================================================================
# Lucky Embroidery - Environment Configuration Example
# Copy this file to .env.local and fill in the values for your environment.
# Never commit .env.local or secret keys into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Required)
# ------------------------------------------------------------------------------
# Project URL from Supabase Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Client Publishable / Anon Key (Safe for browser/client interactions)
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
# Server-Only Secret / Service Role Key (Used for trusted server-side insertion & RLS bypass)
# DO NOT EXPOSE TO BROWSER
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 2. Email Notifications (Resend)
# ------------------------------------------------------------------------------
# API key from resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefg
# Verified sender domain address (e.g., quotes@yourdomain.com or onboarding@resend.dev)
EMAIL_FROM=Lucky Embroidery <quotes@yourdomain.com>
# Business administrator recipient email for new incoming customer alerts
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
# Enable sending customer acknowledgement receipt emails (true/false)
CUSTOMER_ACKNOWLEDGEMENT_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Administrator Access & Authorization
# ------------------------------------------------------------------------------
# Comma-separated list of approved admin user emails for dashboard access
ADMIN_EMAILS=admin@yourdomain.com,owner@yourdomain.com

# ------------------------------------------------------------------------------
# 4. Anti-Bot & CAPTCHA (Cloudflare Turnstile - Optional)
# ------------------------------------------------------------------------------
# Public Site Key for Turnstile widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
# Secret Key for server-side token validation
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# ------------------------------------------------------------------------------
# 5. Distributed Rate Limiting (Upstash Redis - Optional)
# ------------------------------------------------------------------------------
# If omitted, durable Supabase database-backed IP rate limiting is used automatically.
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ------------------------------------------------------------------------------
# 6. Production Safety Switch
# ------------------------------------------------------------------------------
# Set to 'false' to put the website in demonstration mode (validates but skips DB storage)
# Defaults to enabled ('true') for production enquiry persistence
ENQUIRIES_ENABLED=true
